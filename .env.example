# ==============================================================================
# DHAVON Personal AI Operating System — Production Environment Template
# Copy this file to .env or .env.local for development/production deployments.
# NEVER commit .env files containing real credentials or secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Client-Accessible Public Variables (apps/web)
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the client browser.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# ------------------------------------------------------------------------------
# 2. Server Runtime Configuration (apps/api)
# ------------------------------------------------------------------------------
NODE_ENV=production
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
WS_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. Database & Supabase Server Configuration
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 4. Authentication & Security
# ------------------------------------------------------------------------------
JWT_SECRET=your-secure-jwt-secret-at-least-32-chars

# ------------------------------------------------------------------------------
# 5. AI Orchestration Provider Keys (Server-side Only)
# ------------------------------------------------------------------------------
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-pro
GEMINI_API_KEY=your-gemini-key
GROQ_API_KEY=your-groq-key

# ------------------------------------------------------------------------------
# 6. Communications & Integrations
# ------------------------------------------------------------------------------
RESEND_API_KEY=your-resend-key
