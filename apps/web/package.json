{
  "name": "@dhavon/web",
  "version": "0.1.0",
  "private": true,
  "description": "DHAVON AI Observatory Web Interface",
  "scripts": {
    "dev": "next dev -p 3000",
    "prebuild": "pnpm --filter @dhavon/types --filter @dhavon/ui build",
    "build": "pnpm --filter @dhavon/types --filter @dhavon/ui build && next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@dhavon/types": "workspace:*",
    "@dhavon/ui": "workspace:*",
    "framer-motion": "^12.4.7",
    "lucide-react": "^0.475.0",
    "next": "^15.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.7",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
