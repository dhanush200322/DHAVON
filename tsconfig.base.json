{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@dhavon/types": ["packages/types/src/index.ts"],
      "@dhavon/types/*": ["packages/types/src/*"],
      "@dhavon/ui": ["packages/ui/src/index.ts"],
      "@dhavon/ui/*": ["packages/ui/src/*"],
      "@dhavon/mcp": ["packages/mcp/src/index.ts"],
      "@dhavon/mcp/*": ["packages/mcp/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", ".next"]
}
